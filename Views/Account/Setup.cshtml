@model SetupViewModel

@{
    ViewData["Title"] = "Create Administrator Account";
}

<div class="row justify-content-center py-4">
    <div class="col-md-8 col-lg-5">
        <div class="card shadow-sm">
            <div class="card-body p-4">
                <div class="text-center mb-4">
                    <span class="auth-card-icon" aria-hidden="true">
                        <svg viewBox="0 0 24 24" width="28" height="28" fill="currentColor" focusable="false"
                             aria-hidden="true">
                            <path d="M12 3 1 9l11 6 9-4.91V15h2V9L12 3z" />
                            <path d="M5 11.9V16c0 1.66 3.13 3 7 3s7-1.34 7-3v-4.1l-7 3.82-7-3.82z" />
                        </svg>
                    </span>
                    <p class="fw-bold mb-1">StudentAdminPortal</p>
                    <h1 class="h3 mb-1">Create Administrator Account</h1>
                    <p class="text-muted mb-0">
                        This is a one-time setup. Once an administrator account exists,
                        this page stops working and no public registration is available.
                    </p>
                </div>

                @if (ViewData["DatabaseError"] is true)
                {
                    <div class="alert alert-danger" role="alert">
                        Could not connect to the database. Check that SQL Server Express is running,
                        that the <code>StudentAdminPortalDB</code> database exists (see
                        <code>Database/Setup.sql</code>), and that the connection string in
                        <code>appsettings.json</code> is correct — then refresh this page.
                    </div>
                }
                else
                {
                    <form asp-action="Setup" method="post" novalidate>
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3" role="alert"></div>

                        <div class="mb-3">
                            <label asp-for="Username" class="form-label"></label>
                            <input asp-for="Username" class="form-control" placeholder="Choose a username"
                                   autocomplete="username" autofocus />
                            <span asp-validation-for="Username" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Email" class="form-label"></label>
                            <input asp-for="Email" class="form-control" placeholder="Enter admin email address"
                                   autocomplete="email" />
                            <span asp-validation-for="Email" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Password" class="form-label"></label>
                            <div class="input-group">
                                <input asp-for="Password" class="form-control" placeholder="At least 8 characters"
                                       autocomplete="new-password" />
                                <button type="button" class="btn btn-outline-secondary password-toggle"
                                        aria-label="Show password">
                                    <span class="eye-open">
                                        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor"
                                             stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
                                             aria-hidden="true">
                                            <path d="M2 12s3-7 10-7 10 7 10 7-3 7-10 7-10-7-10-7z" />
                                            <circle cx="12" cy="12" r="3" />
                                        </svg>
                                    </span>
                                    <span class="eye-closed d-none">
                                        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor"
                                             stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
                                             aria-hidden="true">
                                            <path d="M9.88 9.88a3 3 0 1 0 4.24 4.24" />
                                            <path
                                            d="M10.73 5.08A10.43 10.43 0 0 1 12 5c7 0 10 7 10 7a13.16 13.16 0 0 1-1.67 2.68" />
                                            <path
                                            d="M6.61 6.61A13.526 13.526 0 0 0 2 12s3 7 10 7a9.74 9.74 0 0 0 5.39-1.61" />
                                            <line x1="2" y1="2" x2="22" y2="22" />
                                        </svg>
                                    </span>
                                </button>
                            </div>
                            <span asp-validation-for="Password" class="text-danger"></span>
                        </div>

                        <div class="mb-4">
                            <label asp-for="ConfirmPassword" class="form-label"></label>
                            <div class="input-group">
                                <input asp-for="ConfirmPassword" class="form-control" placeholder="Repeat the password"
                                       autocomplete="new-password" />
                                <button type="button" class="btn btn-outline-secondary password-toggle"
                                        aria-label="Show password">
                                    <span class="eye-open">
                                        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor"
                                             stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
                                             aria-hidden="true">
                                            <path d="M2 12s3-7 10-7 10 7 10 7-3 7-10 7-10-7-10-7z" />
                                            <circle cx="12" cy="12" r="3" />
                                        </svg>
                                    </span>
                                    <span class="eye-closed d-none">
                                        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor"
                                             stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
                                             aria-hidden="true">
                                            <path d="M9.88 9.88a3 3 0 1 0 4.24 4.24" />
                                            <path
                                            d="M10.73 5.08A10.43 10.43 0 0 1 12 5c7 0 10 7 10 7a13.16 13.16 0 0 1-1.67 2.68" />
                                            <path
                                            d="M6.61 6.61A13.526 13.526 0 0 0 2 12s3 7 10 7a9.74 9.74 0 0 0 5.39-1.61" />
                                            <line x1="2" y1="2" x2="22" y2="22" />
                                        </svg>
                                    </span>
                                </button>
                            </div>
                            <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
                        </div>

                        <button type="submit" class="btn btn-primary w-100 py-2">Create Admin Account</button>
                    </form>
                }

                <p class="text-muted small text-center mt-4 mb-0">
                    Already have an account? <a asp-action="Login">Log in</a>.
                </p>
            </div>
        </div>
        <p class="text-muted small text-center mt-3 mb-0">&copy; 2026 - StudentAdminPortal</p>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

@model DashboardViewModel

@{
    ViewData["Title"] = "Dashboard";
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-4">
    <div>
        <h1 class="h3 mb-0">Dashboard</h1>
        <p class="text-muted mb-0">Overview of your student management system</p>
    </div>
</div>

<div class="row g-3 mb-4">
    <div class="col-md-4">
        <div class="card shadow-sm h-100">
            <div class="card-body d-flex align-items-center gap-3">
                <span class="stat-icon" aria-hidden="true">
                    <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2"
                         stroke-linecap="round" stroke-linejoin="round">
                        <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2" />
                        <circle cx="9" cy="7" r="4" />
                        <path d="M23 21v-2a4 4 0 0 0-3-3.87" />
                        <path d="M16 3.13a4 4 0 0 1 0 7.75" />
                    </svg>
                </span>
                <span>
                    <span class="text-muted d-block">Total Students</span>
                    <span class="display-stat">@Model.TotalStudents</span>
                </span>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card shadow-sm h-100">
            <div class="card-body d-flex align-items-center gap-3">
                <span class="stat-icon" aria-hidden="true">
                    <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2"
                         stroke-linecap="round" stroke-linejoin="round">
                        <path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20" />
                        <path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z" />
                    </svg>
                </span>
                <span>
                    <span class="text-muted d-block">Total Courses</span>
                    <span class="display-stat">@Model.TotalCourses</span>
                </span>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card shadow-sm h-100">
            <div class="card-body d-flex align-items-center gap-3">
                <span class="stat-icon" aria-hidden="true">
                    <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2"
                         stroke-linecap="round" stroke-linejoin="round">
                        <circle cx="12" cy="12" r="10" />
                        <polyline points="12 6 12 12 16 14" />
                    </svg>
                </span>
                <span>
                    <span class="text-muted d-block">Recent Registrations</span>
                    <span class="display-stat">@Model.RecentStudents.Count</span>
                </span>
            </div>
        </div>
    </div>
</div>

<div class="row g-3">
    <div class="col-lg-8">
        <h2 class="h5 mb-3">Recently Registered Students</h2>

        @if (!Model.RecentStudents.Any())
        {
            <div class="empty-state">
                <span class="empty-state-icon" aria-hidden="true">
                    <svg viewBox="0 0 24 24" width="36" height="36" fill="none" stroke="currentColor" stroke-width="2"
                         stroke-linecap="round" stroke-linejoin="round">
                        <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2" />
                        <circle cx="9" cy="7" r="4" />
                        <path d="M23 21v-2a4 4 0 0 0-3-3.87" />
                        <path d="M16 3.13a4 4 0 0 1 0 7.75" />
                    </svg>
                </span>
                <h3 class="h5 mb-1">No Students Found</h3>
                <p class="text-muted mb-3">There are no student records yet. Add your first student to get started.</p>
                <a asp-controller="Students" asp-action="Create" class="btn btn-primary">Add Student</a>
            </div>
        }
        else
        {
            <div class="card shadow-sm">
                <div class="table-responsive">
                    <table class="table portal-table table-hover align-middle mb-0">
                        <thead>
                            <tr>
                                <th>#</th>
                                <th>Name</th>
                                <th>Email</th>
                                <th>Course</th>
                                <th>Date</th>
                                <th class="text-end">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @{
                                var row = 0;
                            }
                            @foreach (var student in Model.RecentStudents)
                            {
                                <tr>
                                    <td>@(++row)</td>
                                    <td>@student.FullName</td>
                                    <td>@student.Email</td>
                                    <td>@student.Course</td>
                                    <td>@student.RegistrationDate.ToLocalTime().ToString("dd MMM yyyy")</td>
                                    <td class="text-end text-nowrap">
                                        <a asp-controller="Students" asp-action="Details" asp-route-id="@student.Id"
                                           class="btn btn-sm btn-outline-secondary">Details</a>
                                        <a asp-controller="Students" asp-action="Edit" asp-route-id="@student.Id"
                                           class="btn btn-sm btn-outline-primary">Edit</a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
            <p class="mt-3 mb-0">
                <a asp-controller="Students" asp-action="Index">View All Students &rarr;</a>
            </p>
        }
    </div>

    <div class="col-lg-4">
        <div class="card shadow-sm">
            <div class="card-body">
                <h2 class="h5 mb-3">Quick Actions</h2>
                <div class="d-grid gap-2">
                    <a asp-controller="Students" asp-action="Create" class="btn btn-primary">Add New Student</a>
                    <a asp-controller="Students" asp-action="Index" class="btn btn-outline-primary">View All
                        Students</a>
                        <a asp-controller="Students" asp-action="Index" asp-fragment="student-search"
                           class="btn btn-outline-primary">Search Students</a>
                    </div>
                </div>
            </div>
        </div>
    </div>

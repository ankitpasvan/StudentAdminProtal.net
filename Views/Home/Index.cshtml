@{
    ViewData["Title"] = "Home Page";
}

<div class="row justify-content-center">
    <div class="col-md-8 col-lg-6 text-center">
        <h1 class="display-5 mb-3">StudentAdminPortal</h1>
        <p class="text-muted mb-4">
            Manage student registrations from a single protected admin portal.
        </p>

        @if (User.Identity?.IsAuthenticated == true)
        {
            <div class="d-flex gap-2 justify-content-center">
                <a asp-controller="Dashboard" asp-action="Index" class="btn btn-primary px-4">Go to Dashboard</a>
                <a asp-controller="Students" asp-action="Index" class="btn btn-outline-primary px-4">View Students</a>
            </div>
        }
        else
        {
            <div class="d-flex gap-2 justify-content-center">
                <a asp-controller="Account" asp-action="Login" class="btn btn-primary px-4">Admin Login</a>
                <a asp-controller="Account" asp-action="Setup" class="btn btn-outline-primary px-4">First-Time Setup</a>
            </div>
            <p class="text-muted small mt-4">
                First-time setup creates the administrator account. Once an administrator
                exists, the setup page stops working and only login is available.
            </p>
        }
    </div>
</div>

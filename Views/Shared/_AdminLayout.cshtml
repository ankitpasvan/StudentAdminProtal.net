@* Admin layout: sidebar + top bar, used by Dashboard and Students views only.
   Public pages (Home, Login, Setup, Privacy, Error) keep _Layout.cshtml.
   No database access happens in this file; it only renders navigation. *@
@{
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
    var userName = User.Identity?.Name ?? "";
    var userInitial = userName.Length > 0 ? userName[..1].ToUpperInvariant() : "?";
}
<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - StudentAdminPortal</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>

<body>
    <div class="portal-admin">
        <!-- Sidebar: static column on large screens, offcanvas drawer below lg. -->
        <aside id="adminSidebar" class="portal-sidebar offcanvas-lg offcanvas-start" tabindex="-1"
               aria-labelledby="adminSidebarLabel">
            <div class="portal-sidebar-brand">
                <a asp-controller="Dashboard" asp-action="Index" class="portal-brand">
                    <span class="brand-mark brand-mark-solid" aria-hidden="true">
                        <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor" focusable="false"
                             aria-hidden="true">
                            <path d="M12 3 1 9l11 6 9-4.91V15h2V9L12 3z" />
                            <path d="M5 11.9V16c0 1.66 3.13 3 7 3s7-1.34 7-3v-4.1l-7 3.82-7-3.82z" />
                        </svg>
                    </span>
                    <span id="adminSidebarLabel">StudentAdminPortal</span>
                </a>
                <button type="button" class="btn-close d-lg-none" data-bs-dismiss="offcanvas"
                        data-bs-target="#adminSidebar" aria-label="Close menu"></button>
            </div>
            <div class="offcanvas-body d-flex flex-column p-0">
                <nav class="portal-nav" aria-label="Admin navigation">
                    <a asp-controller="Dashboard" asp-action="Index"
                       class="portal-nav-link @(currentController == "Dashboard" ? "active" : "")">
                        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor"
                             stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <rect x="3" y="3" width="7" height="7" rx="1" />
                            <rect x="14" y="3" width="7" height="7" rx="1" />
                            <rect x="14" y="14" width="7" height="7" rx="1" />
                            <rect x="3" y="14" width="7" height="7" rx="1" />
                        </svg>
                        Dashboard
                    </a>
                    <a asp-controller="Students" asp-action="Index"
                       class="portal-nav-link @(currentController == "Students" ? "active" : "")">
                        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor"
                             stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2" />
                            <circle cx="9" cy="7" r="4" />
                            <path d="M23 21v-2a4 4 0 0 0-3-3.87" />
                            <path d="M16 3.13a4 4 0 0 1 0 7.75" />
                        </svg>
                        Students
                    </a>
                </nav>
                <form asp-controller="Account" asp-action="Logout" method="post" class="mt-auto p-3 border-top">
                    <button type="submit" class="portal-nav-link w-100 text-start bg-transparent border-0">
                        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor"
                             stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4" />
                            <polyline points="16 17 21 12 16 7" />
                            <line x1="21" y1="12" x2="9" y2="12" />
                        </svg>
                        Logout
                    </button>
                </form>
            </div>
        </aside>

        <div class="portal-admin-main">
            <header class="portal-topbar">
                <button type="button" class="btn btn-outline-secondary d-lg-none" data-bs-toggle="offcanvas"
                        data-bs-target="#adminSidebar" aria-controls="adminSidebar" aria-label="Open menu">
                    <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2"
                         stroke-linecap="round" aria-hidden="true">
                        <line x1="3" y1="6" x2="21" y2="6" />
                        <line x1="3" y1="12" x2="21" y2="12" />
                        <line x1="3" y1="18" x2="21" y2="18" />
                    </svg>
                </button>
                <span class="portal-topbar-title d-none d-md-block text-muted">@ViewData["Title"]</span>
                <span class="ms-auto d-flex align-items-center gap-2">
                    <span class="avatar avatar-sm" aria-hidden="true">@userInitial</span>
                    <span class="fw-semibold d-none d-sm-inline">@userName</span>
                </span>
            </header>

            <main class="portal-content">
                @if (TempData["SuccessMessage"] is string successMessage)
                {
                    <div class="alert alert-success alert-dismissible fade show" role="alert">
                        @successMessage
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                }
                @RenderBody()
            </main>

            <footer class="portal-admin-footer">
                <span class="text-muted">&copy; 2026 - StudentAdminPortal - <a asp-controller="Home"
                                                                                   asp-action="Privacy">Privacy</a></span>
                </footer>
            </div>
        </div>

        <script src="~/lib/jquery/dist/jquery.min.js"></script>
        <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
        <script src="~/js/site.js" asp-append-version="true"></script>
        @await RenderSectionAsync("Scripts", required: false)
    </body>

</html>

@model Student

@{
    ViewData["Title"] = "Delete Student";
}

<div class="row justify-content-center">
    <div class="col-md-8 col-lg-6">
        <div class="card shadow-sm border-danger">
            <div class="card-body p-4">
                <h1 class="h3 card-title mb-1">Delete Student</h1>
                <p class="text-muted mb-4">Are you sure you want to delete this student? This cannot be undone.</p>

                <dl class="row mb-4">
                    <dt class="col-sm-4">Student ID</dt>
                    <dd class="col-sm-8">@Model.Id</dd>

                    <dt class="col-sm-4">Full Name</dt>
                    <dd class="col-sm-8">@Model.FullName</dd>

                    <dt class="col-sm-4">Email</dt>
                    <dd class="col-sm-8">@Model.Email</dd>

                    <dt class="col-sm-4">Course</dt>
                    <dd class="col-sm-8">@Model.Course</dd>

                    <dt class="col-sm-4">Registered</dt>
                    <dd class="col-sm-8">@Model.RegistrationDate.ToLocalTime().ToString("dd MMM yyyy, HH:mm")</dd>
                </dl>

                <form asp-action="Delete" method="post">
                    <input type="hidden" asp-for="Id" />
                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-danger px-4">Delete</button>
                        <a asp-action="Index" class="btn btn-secondary px-4">Cancel</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@model Student

@{
    ViewData["Title"] = "Student Details";
}

<div class="row justify-content-center">
    <div class="col-md-8 col-lg-6">
        <div class="card shadow-sm">
            <div class="card-body p-4">
                <h1 class="h3 card-title mb-4">Student Details</h1>

                <dl class="row mb-4">
                    <dt class="col-sm-4">Student ID</dt>
                    <dd class="col-sm-8">@Model.Id</dd>

                    <dt class="col-sm-4">Full Name</dt>
                    <dd class="col-sm-8">@Model.FullName</dd>

                    <dt class="col-sm-4">Email</dt>
                    <dd class="col-sm-8">@Model.Email</dd>

                    <dt class="col-sm-4">Course</dt>
                    <dd class="col-sm-8">@Model.Course</dd>

                    <dt class="col-sm-4">Registered</dt>
                    <dd class="col-sm-8">@Model.RegistrationDate.ToLocalTime().ToString("dd MMM yyyy, HH:mm")</dd>
                </dl>

                <div class="d-flex gap-2">
                    <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary px-4">Edit</a>
                    <a asp-action="Index" class="btn btn-secondary px-4">Back to List</a>
                </div>
            </div>
        </div>
    </div>
</div>

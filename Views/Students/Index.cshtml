@model IEnumerable<Student>

@{
    ViewData["Title"] = "Students";
    var currentSearch = ViewData["CurrentSearch"] as string;
    var isSearching = !string.IsNullOrWhiteSpace(currentSearch);
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="h3 mb-0">Students</h1>
    <a asp-action="Create" class="btn btn-primary">Add Student</a>
</div>

<form asp-action="Index" method="get" class="row g-2 mb-4">
    <div class="col-md-8 col-lg-6">
        <input type="search" name="search" value="@currentSearch" class="form-control"
               placeholder="Search by name or email" aria-label="Search students" />
    </div>
    <div class="col-auto">
        <button type="submit" class="btn btn-outline-primary">Search</button>
        @if (isSearching)
        {
            <a asp-action="Index" class="btn btn-outline-secondary">Clear</a>
        }
    </div>
</form>

@if (!Model.Any())
{
    <div class="alert alert-info" role="alert">
        @if (isSearching)
        {
            <span>No students match "@currentSearch".</span>
            <a asp-action="Index" class="alert-link">Show all students</a><span>.</span>
        }
        else
        {
            <span>No students are registered yet.</span>
            <a asp-action="Create" class="alert-link">Register the first student</a><span>.</span>
        }
    </div>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped table-hover align-middle">
            <thead class="table-primary">
                <tr>
                    <th>Student ID</th>
                    <th>Full Name</th>
                    <th>Email</th>
                    <th>Course</th>
                    <th>Registered</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var student in Model)
                {
                    <tr>
                        <td>@student.Id</td>
                        <td>@student.FullName</td>
                        <td>@student.Email</td>
                        <td>@student.Course</td>
                        <td>@student.RegistrationDate.ToLocalTime().ToString("dd MMM yyyy")</td>
                        <td class="text-end text-nowrap">
                            <a asp-action="Details" asp-route-id="@student.Id"
                               class="btn btn-sm btn-outline-secondary">Details</a>
                            <a asp-action="Edit" asp-route-id="@student.Id" class="btn btn-sm btn-outline-primary">Edit</a>
                            <a asp-action="Delete" asp-route-id="@student.Id" class="btn btn-sm btn-outline-danger">Delete</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

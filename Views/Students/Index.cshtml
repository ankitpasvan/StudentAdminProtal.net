@model IEnumerable<Student>

@{
    ViewData["Title"] = "Students";
    var currentSearch = ViewData["CurrentSearch"] as string;
    var isSearching = !string.IsNullOrWhiteSpace(currentSearch);
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-1">
    <div>
        <h1 class="h3 mb-0">Students</h1>
        <p class="text-muted mb-0">Manage and view all student records</p>
    </div>
    <a asp-action="Create" class="btn btn-primary">
        <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2"
             stroke-linecap="round" aria-hidden="true">
            <line x1="12" y1="5" x2="12" y2="19" />
            <line x1="5" y1="12" x2="19" y2="12" />
        </svg>
        Add Student
    </a>
</div>

<form asp-action="Index" method="get" class="d-flex gap-2 my-4">
    <div class="input-group">
        <span class="input-group-text bg-white" aria-hidden="true">
            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2"
                 stroke-linecap="round" stroke-linejoin="round">
                <circle cx="11" cy="11" r="8" />
                <line x1="21" y1="21" x2="16.65" y2="16.65" />
            </svg>
        </span>
        <input type="search" id="student-search" name="search" value="@currentSearch" class="form-control"
               placeholder="Search by name or email" aria-label="Search students" />
    </div>
    <button type="submit" class="btn btn-outline-primary flex-shrink-0">Search</button>
    @if (isSearching)
    {
        <a asp-action="Index" class="btn btn-outline-secondary flex-shrink-0">Clear</a>
    }
</form>

@if (!Model.Any())
{
    @if (isSearching)
    {
        <div class="empty-state">
            <span class="empty-state-icon" aria-hidden="true">
                <svg viewBox="0 0 24 24" width="36" height="36" fill="none" stroke="currentColor" stroke-width="2"
                     stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="11" cy="11" r="8" />
                    <line x1="21" y1="21" x2="16.65" y2="16.65" />
                </svg>
            </span>
            <h2 class="h5 mb-1">No Students Found</h2>
            <p class="text-muted mb-3">No students match "@currentSearch".</p>
            <a asp-action="Index" class="btn btn-outline-primary">Show all students</a>
        </div>
    }
    else
    {
        <div class="empty-state">
            <span class="empty-state-icon" aria-hidden="true">
                <svg viewBox="0 0 24 24" width="36" height="36" fill="none" stroke="currentColor" stroke-width="2"
                     stroke-linecap="round" stroke-linejoin="round">
                    <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2" />
                    <circle cx="9" cy="7" r="4" />
                    <path d="M23 21v-2a4 4 0 0 0-3-3.87" />
                    <path d="M16 3.13a4 4 0 0 1 0 7.75" />
                </svg>
            </span>
            <h2 class="h5 mb-1">No Students Found</h2>
            <p class="text-muted mb-3">There are no student records yet. Add your first student to get started.</p>
            <a asp-action="Create" class="btn btn-primary">Add Student</a>
        </div>
    }
}
else
{
    <div class="card shadow-sm">
        <div class="table-responsive">
            <table class="table portal-table table-hover align-middle mb-0">
                <thead>
                    <tr>
                        <th>Student ID</th>
                        <th>Name</th>
                        <th>Email</th>
                        <th>Course</th>
                        <th>Registration Date</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var student in Model)
                    {
                        <tr>
                            <td>@student.Id</td>
                            <td>@student.FullName</td>
                            <td>@student.Email</td>
                            <td>@student.Course</td>
                            <td>@student.RegistrationDate.ToLocalTime().ToString("dd MMM yyyy")</td>
                            <td class="text-end text-nowrap">
                                <a asp-action="Details" asp-route-id="@student.Id" class="icon-btn" title="View details"
                                   aria-label="View details for @student.FullName">
                                    <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor"
                                         stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                        <path d="M2 12s3-7 10-7 10 7 10 7-3 7-10 7-10-7-10-7z" />
                                        <circle cx="12" cy="12" r="3" />
                                    </svg>
                                </a>
                                <a asp-action="Edit" asp-route-id="@student.Id" class="icon-btn" title="Edit student"
                                   aria-label="Edit @student.FullName">
                                    <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor"
                                         stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                        <path d="M17 3a2.85 2.83 0 1 1 4 4L7.5 20.5 2 22l1.5-5.5L17 3z" />
                                    </svg>
                                </a>
                                <a asp-action="Delete" asp-route-id="@student.Id" class="icon-btn icon-btn-danger"
                                   title="Delete student" aria-label="Delete @student.FullName">
                                    <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor"
                                         stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                        <polyline points="3 6 5 6 21 6" />
                                        <path
                                        d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2" />
                                    </svg>
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}
